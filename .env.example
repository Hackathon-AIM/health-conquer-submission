# cp .env.example .env  후 값을 채우세요. .env 는 .gitignore 에 있습니다.
#
# ⚠️ API 키를 코드·yaml·채팅에 붙여넣지 마세요. 노출되면 즉시 폐기하고 재발급하세요.

# 검증용 (configs/openai.yaml)
OPENAI_API_KEY=

# 현장용 (configs/live.yaml) — 오프닝에서 받은 값
MEDAI_BASE_URL=
MEDAI_API_KEY=

# 빠른 오버라이드
# MEDAI_RETRIEVAL_MODE=mock

# ── 입력 컨텍스트 예산 ───────────────────────────────────────────────
# 실측(2026-08-22): 서버 창은 131,072 tok, 출력 상한 32,768. 아래 값은 창이 아니라
# '작업 예산'이다 — 창에 들어가는 것과 모델이 제대로 쓰는 것은 다르고(context rot),
# 12만 토큰 프롬프트는 지연 목표에서도 예산 초과다. 이 값 하나가 시스템 프롬프트·
# 대화 길이·근거 블록·툴 스키마 몫을 전부 역산한다.
#   한계 재기: python scripts/probe_endpoint.py
#   절감 재기: python scripts/context_audit.py
# LUNIT_MAX_INPUT_TOKENS=32768   # 하드 실링은 131,072 (실측)
#
# 토큰 추정 안전계수. 추정이 실제보다 작으면 조용히 잘리므로 기본값은 넉넉하다.
# 매 응답의 usage.prompt_tokens 로 자동 보정된다 (실측 6회 만에 scale 1.050 수렴).
# LUNIT_TOKEN_SAFETY=1.12
#
# 모델에게 보여 줄 MCP 툴 개수(전체 21개 중) / 생성 단계에 넣을 근거 조각 수
# LUNIT_MAX_MCP_TOOLS=6
# LUNIT_MAX_EVIDENCE_BLOCKS=5
#
# 툴 결과 원문을 흘려보낼 디렉터리 (사후 감사용. 기본값은 임시 디렉터리)
# LUNIT_SPILL_DIR=
