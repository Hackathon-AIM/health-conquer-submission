# Copy this file to .env and fill in values locally. Do not commit .env.

# Development mode can use any OpenAI-compatible endpoint. Submission mode must use L2.
# Official Lunit hackathon variables:
LUNIT_FM_API_URL=https://model.hackathon.lunit.io
LUNIT_FM_MODEL=Lunit/L2-preview
LUNIT_FM_API_KEY=lunit_replace_me

# MediBot aliases are also supported. Leave unset when using LUNIT_FM_* above.
# MEDIBOT_MODEL_API_BASE=https://api.example.local/v1
# MEDIBOT_MODEL_NAME=l2-chat
# MEDIBOT_MODEL_API_KEY=replace-me

# Final generation guard. Set both values for hackathon submission.
MEDIBOT_FINAL_MODEL_PROVIDER=lunit_l2
MEDIBOT_REQUIRE_L2_FINAL=1

# Keep fallback enabled only for local development. Use 0 for submission rehearsal.
MEDIBOT_ALLOW_FALLBACK=1

# Retrieval backend:
# - mini: deterministic local smoke-test corpus
# - lunit_mcp: Lunit-provided MCP/tool sources only
# - hybrid: MCP sources first, mini fallback for local testing
MEDIBOT_RAG_BACKEND=mini
MEDIBOT_ENABLED_MCP_SOURCES=drug_label,drug_pricing,disease_code,law,guideline,pubmed,faers,hira_coverage
MEDIBOT_MCP_URL=https://mcp.hackathon.lunit.io/mcp
MEDIBOT_MCP_PROTOCOL_VERSION=2025-11-25
MEDIBOT_L2_GENERATION_TOOL_BUDGET=2
MEDIBOT_L2_RETRIEVAL_TOOL_BUDGET=10
MEDIBOT_L2_TOOL_RESULT_CHAR_LIMIT=2500
MEDIBOT_TRACE_CONTENT_CHAR_LIMIT=1000
MEDIBOT_SOURCE_TIMEOUT_S=8
MEDIBOT_EVIDENCE_LIMIT=5
