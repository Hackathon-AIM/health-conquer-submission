# 복사해서 .env 로 저장하고 실제 값을 채운다.
#   cp .env.example .env
# .env 는 커밋되지 않는다 (.gitignore).

# 대시보드 /api-keys 에서 발급한 팀 키.
# 이 키 하나로 Model · MCP · Patient Simulator 셋 다 인증한다.
LUNIT_FM_API_KEY=

LUNIT_FM_API_URL=https://model.hackathon.lunit.io
LUNIT_FM_MODEL=Lunit/L2-preview
LUNIT_MCP_URL=https://mcp.hackathon.lunit.io/mcp
LUNIT_MCP_PROTOCOL_VERSION=2026-07-28
LUNIT_PATIENT_URL=https://patient.hackathon.lunit.io
LUNIT_PATIENT_MODEL=patient-simulator-ko

# 서버 상한이 2048 이다. 넘기면 400 output_limit_exceeded.
FM_MAX_TOKENS=2048
FM_TIMEOUT=180

# L2 의 사고과정(reasoning)은 2048 예산을 통째로 먹어서 답변이 잘린다.
# 1 로 켜면 finish_reason=length 로 끊길 각오를 해야 한다. 기본 0.
FM_THINKING=0

# Retrieval 폭주와 대화 지연을 막는 하네스 상한.
LUNIT_MAX_RETRIEVAL_STEPS=6
LUNIT_MAX_TOOL_CALLS=4
LUNIT_MAX_RETRIEVAL_CALLS=1
LUNIT_RETRIEVAL_TIMEOUT_S=90
LUNIT_MCP_TIMEOUT_S=30
LUNIT_MAX_CONTEXT_CHARS=12000
